<script>
document.addEventListener('DOMContentLoaded', function() {
    const matches = document.querySelectorAll('.card');
    const dates = new Set();
    
    // Ekstrak tanggal dari setiap card
    matches.forEach(m => {
        const title = m.querySelector('.match-header').innerText;
        const dateMatch = title.match(/\d{4}-\d{2}-\d{2}/);
        if (dateMatch) {
            m.setAttribute('data-date', dateMatch[0]);
            dates.add(dateMatch[0]);
        }
    });
    
    // Buat UI Filter
    const filterContainer = document.createElement('div');
    filterContainer.className = 'filter-container';
    filterContainer.innerHTML = `
        <div class="filter-group">
            <label>Pilih Tanggal</label>
            <select id="dateFilter">
                <option value="all">Semua Tanggal</option>
                ${Array.from(dates).sort().map(d => `<option value="${d}">${d}</option>`).join('')}
            </select>
        </div>
        <div class="filter-group">
            <label>Urutkan Berdasarkan</label>
            <select id="sortFilter">
                <option value="default">Default (Liga)</option>
                <option value="date-asc">Tanggal (Awal - Akhir)</option>
                <option value="date-desc">Tanggal (Akhir - Awal)</option>
            </select>
        </div>
    `;
    
    const mainContainer = document.querySelector('.container') || document.body;
    mainContainer.insertBefore(filterContainer, mainContainer.firstChild);

    // Logika Filter Tanggal
    document.getElementById('dateFilter').addEventListener('change', function(e) {
        const val = e.target.value;
        matches.forEach(m => {
            if (val === 'all' || m.getAttribute('data-date') === val) {
                m.style.display = 'block';
            } else {
                m.style.display = 'none';
            }
        });
    });
});
</script>


<script>
document.addEventListener('DOMContentLoaded', function() {
    const debugPanel = document.createElement('div');
    debugPanel.style.cssText = 'position:fixed; bottom:10px; right:10px; background:rgba(0,0,0,0.9); color:#0f0; padding:15px; font-family:monospace; font-size:12px; z-index:9999; border:1px solid #333; max-height:200px; overflow-y:auto; border-radius:8px; box-shadow: 0 4px 6px rgba(0,0,0,0.3);';
    
    let html = '<b>🔍 DEBUG DATA (H2H)</b><br/>';
    
    // Ambil semua card match
    const cards = document.querySelectorAll('.card');
    html += `Total Match: ${cards.length}<br/><br/>`;
    
    cards.forEach((card, i) => {
        const text = card.innerText;
        // Ambil nama tim (biasanya di tag h2 atau h3)
        const titleEl = card.querySelector('h2, h3, .team-name');
        const title = titleEl ? titleEl.innerText.replace(/
/g, ' ') : `Match ${i+1}`;
        
        // Cek apakah ada teks H2H
        const h2hText = text.includes('Pertemuan') ? '✅ ADA H2H' : '❌ TIDAK ADA H2H';
        
        // Tampilkan di panel
        html += `${title}: <span style="color:${h2hText.includes('✅') ? '#0f0' : '#f00'}">${h2hText}</span><br/>`;
    });
    
    debugPanel.innerHTML = html;
    document.body.appendChild(debugPanel);
});
</script>

